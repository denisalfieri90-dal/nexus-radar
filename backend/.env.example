# Copia in .env e compila. Solo ANTHROPIC_API_KEY serve per i briefing;
# senza le altre chiavi il radar funziona con meno fonti (la pagina Fonti lo mostra).

DATABASE_URL=sqlite:///./nexus.db

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Gratuita: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# La SEC richiede nome ed email reali nello User-Agent
SEC_USER_AGENT=NexusRadar Nome Cognome tua@email.it
# Opzionale: alza i limiti di GitHub (token senza permessi)
GITHUB_TOKEN=

# Protegge /api/jobs e il webhook TradingView
ADMIN_TOKEN=cambia-questo-valore
CORS_ORIGINS=http://localhost:3000
# In locale: aggiornamento automatico (news ogni ora, resto alle 7:10)
ENABLE_SCHEDULER=true
